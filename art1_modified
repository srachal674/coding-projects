from turtle import*
shape("turtle")
speed(0)
bgcolor("#f2f2f2")

colors = ["blue","purple","red","orange","yellow","green"]
small_radius = 50
med_radius = 75
lg_radius = 100

for a in range(2):
    for c in colors:
        #Small circle
        begin_fill()
        color(c)
        circle(small_radius)
        right(50)

        #Medium circle
        begin_fill()
        color(c)
        circle(med_radius)
        right(50)

        #Large circle
        begin_fill()
        color(c)
        circle(lg_radius)
        right(50)
done()